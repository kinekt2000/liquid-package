{
	"schemaVersion": 1,
	"id": "liquid-package",
	"version": "${version}",
	"name": "Liquid Package",
	"description": "Adds Sublimator block and Empty/Packed Shell items to store liquid (mostly fuel) as solid fuel",
	"authors": [
		"John C. Alastor"
	],
	"contact": {
		"homepage": "https://modrinth.com/user/kinekt2000",
		"sources": "https://github.com/kinekt2000/liquid-package"
	},
	"license": "MIT",
	"icon": "assets/liquid-package/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.liquidpackage.LiquidPackage"
		],
		"client": [
			"com.liquidpackage.client.LiquidPackageClient"
		],
		"jei_mod_plugin": [
			"com.liquidpackage.client.jei.LiquidPackageJeiPlugin"
		],
		"rei_client": [
			"com.liquidpackage.client.rei.LiquidPackageReiPlugin"
		],
		"fabric-datagen": [
			"com.liquidpackage.LiquidPackageDataGen",
			"com.liquidpackage.client.LiquidPackageDataGenClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}